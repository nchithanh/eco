# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.tmp/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local tooling (canvas-mcp venv, uv binaries)
.tools/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OpenNext
.open-next

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example

# Cloudflare Workers (paste-deploy locally; not part of Pages repo)
/workers/

# Nested FE *app code* lives in nchithanh/dolphinOps — keep context/docs in this tree
/products/saas/dolphin_ops/frontend/**
!/products/saas/dolphin_ops/frontend/context/
!/products/saas/dolphin_ops/frontend/context/**
!/products/saas/dolphin_ops/frontend/documentations/
!/products/saas/dolphin_ops/frontend/documentations/**
!/products/saas/dolphin_ops/frontend/AGENTS.md
!/products/saas/dolphin_ops/frontend/README.md
!/products/saas/dolphin_ops/frontend/FRONTEND.md

# Nested BE *app code* lives in nchithanh/dolphinOpsBackend — keep docs in this tree
/products/saas/dolphin_ops/backend/**
!/products/saas/dolphin_ops/backend/documentations/
!/products/saas/dolphin_ops/backend/documentations/**
!/products/saas/dolphin_ops/backend/README.md
!/products/saas/dolphin_ops/backend/AGENTS.md


!.env.example

# Local AI agent packs & internal docs (marketing site only — not product apps)
.cursor/
.claude/
/docs/
/documentations/
/AGENTS.md
/CLAUDE.md
